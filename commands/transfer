# --- Site Transfer (backup / restore) ---
#
# Cove's own implementation of the two operations `cove pull` and `cove push`
# need. It replaces piping https://captaincore.io/do into bash on both the
# local machine and the user's remote server: that fetched 7300+ lines to use
# roughly 490 of them, tied Cove's behaviour to a script released separately
# (a mismatch there once made `cove pull` wipe a database it then refused to
# restore into), and required the remote to be online to captaincore.io.
#
# The helper below is emitted as one self-contained script and run identically
# on both ends — locally with bash, remotely by piping it into `bash -s --`
# over the SSH connection pull/push already hold open. Same code both sides
# means one archive contract rather than two implementations agreeing by luck.
#
# Everything moves over SSH, so no HTTP download happens at any point. That is
# what retires the old failure mode where the backup URL was built from the
# remote's own `home` option and therefore only resolved when the remote's
# WordPress URL was publicly reachable.

COVE_WP_CLI_PHAR_URL="https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar"

# Emit the transfer helper. Quoted heredoc: this text is shipped verbatim and
# must not expand anything on Cove's side.
transfer_helper_source() {
cat << 'COVE_TRANSFER_HELPER'
#!/bin/bash
# cove-transfer — self-contained WordPress backup/restore.
# Generated by Cove. Runs on the local machine and on remote hosts alike.
#
# Subcommands:
#   probe   <site_dir>                     report tool capabilities as key=value
#   backup  <site_dir> [--exclude=GLOB]... [--only-prefix]
#                                          create an archive, print its path
#   restore <site_dir> <archive> [--url-to=URL] [--keep=PATH]... [--refuse-freighter]
#
# All three take --tenant=<id> to work on one WP Freighter tenant of the
# install at <site_dir> rather than the install itself: its stacked_<id>_
# tables and the folder that belongs to it alone, never the shared core, the
# other tenants or the main site.
#
# Design note: every capability degrades rather than failing. Archiving prefers
# zip, falls back to tar, and finally to PHP itself; the database is dumped and
# imported through the native client when present and through WordPress's own
# $wpdb when it isn't. Because the target is always a WordPress install, PHP is
# guaranteed to exist — which makes the PHP tier a true universal fallback and
# means a bare host needs no package installs at all.

set -uo pipefail

WP=""            # resolved WP-CLI invocation (may include php + phar + --allow-root)
ARCHIVER=""      # zip | tar | php
EXTRACTOR=""     # unzip | tar | php
DB_DUMP=""       # native | php
DB_LOAD=""       # native | php
WP_CLI_PHAR=""   # optional sideloaded phar path (--wp-cli=)
TENANT=""        # WP Freighter tenant id (--tenant=), exported as STACKED_SITE_ID
ONLY_PREFIX=false  # dump only the tables under the site's own prefix (--only-prefix)
REFUSE_FREIGHTER=false  # a whole-site restore refuses a WP Freighter host (--refuse-freighter)

log()  { [ "${QUIET:-false}" = true ] || echo "$@" >&2; }
die()  { echo "cove-transfer: $*" >&2; exit 1; }

# --- package install (tier 3) -------------------------------------------------
# Only attempted when we're already root or hold passwordless sudo; a tool that
# stops to ask for a password would hang the non-interactive SSH session that
# invoked us. Failure here is never fatal — the PHP tier still covers us.
pkg_install() {
    local pkg="$1" sudo_cmd=""
    if [ "$(id -u)" != "0" ]; then
        if command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
            sudo_cmd="sudo -n"
        else
            return 1
        fi
    fi
    if   command -v apt-get >/dev/null 2>&1; then $sudo_cmd apt-get install -y -qq "$pkg" >/dev/null 2>&1
    elif command -v dnf     >/dev/null 2>&1; then $sudo_cmd dnf install -y -q "$pkg"      >/dev/null 2>&1
    elif command -v yum     >/dev/null 2>&1; then $sudo_cmd yum install -y -q "$pkg"      >/dev/null 2>&1
    elif command -v apk     >/dev/null 2>&1; then $sudo_cmd apk add --no-cache "$pkg"     >/dev/null 2>&1
    elif command -v zypper  >/dev/null 2>&1; then $sudo_cmd zypper -q install -y "$pkg"   >/dev/null 2>&1
    elif command -v brew    >/dev/null 2>&1; then brew install "$pkg"                     >/dev/null 2>&1
    else return 1
    fi
}

have() { command -v "$1" >/dev/null 2>&1; }

# --- WP-CLI -------------------------------------------------------------------
# Order: an explicitly sideloaded phar, then wp/wp-cli on PATH, then a phar
# already sitting in the usual spots. --allow-root is appended when running as
# root, which is the norm inside containers and trips WP-CLI by default.
resolve_wp() {
    local root_flag=""
    [ "$(id -u)" = "0" ] && root_flag=" --allow-root"

    if [ -n "$WP_CLI_PHAR" ] && [ -f "$WP_CLI_PHAR" ]; then
        have php || die "PHP not found; cannot run the sideloaded WP-CLI."
        WP="php $WP_CLI_PHAR$root_flag"; return 0
    fi
    local c
    for c in wp wp-cli; do
        if have "$c"; then WP="$c$root_flag"; return 0; fi
    done
    for c in "$HOME/wp-cli.phar" /usr/local/bin/wp-cli.phar ./wp-cli.phar; do
        if [ -f "$c" ] && have php; then WP="php $c$root_flag"; return 0; fi
    done
    return 1
}

# $table_prefix straight out of a wp-config.php, without booting PHP — the
# source's config may name a database that does not exist on this machine.
read_table_prefix() {
    [ -f "$1" ] || return 0
    grep -m1 -E '^[[:space:]]*\$table_prefix[[:space:]]*=' "$1" 2>/dev/null \
        | sed -nE "s/.*=[[:space:]]*['\"]([A-Za-z0-9_]+)['\"].*/\1/p"
}

# Fallback when the archive carries no readable config: the prefix is whatever
# precedes `options` in the dump's CREATE TABLE for the options table.
infer_table_prefix_from_dump() {
    grep -m1 -oE 'CREATE TABLE `?[A-Za-z0-9_]*options`?' "$1" 2>/dev/null \
        | sed -E 's/CREATE TABLE `?([A-Za-z0-9_]*)options`?/\1/'
}

# --- capability detection -----------------------------------------------------
# php_has <extension|class> — asks PHP directly rather than guessing from the
# distro, since ZipArchive in particular is a separate package on many hosts.
php_has_zip()  { have php && php -r 'exit(class_exists("ZipArchive")?0:1);' 2>/dev/null; }
php_has_phar() { have php && php -r 'exit(class_exists("PharData")?0:1);' 2>/dev/null; }

resolve_archiver() {
    if have zip; then ARCHIVER=zip; return 0; fi
    if have tar; then ARCHIVER=tar; return 0; fi
    pkg_install zip && have zip && { ARCHIVER=zip; return 0; }
    if php_has_zip;  then ARCHIVER=php;  return 0; fi
    if php_has_phar; then ARCHIVER=phar; return 0; fi
    return 1
}

resolve_extractor() {
    local archive="${1:-}"
    case "$archive" in
        *.tar.gz|*.tgz)
            have tar && { EXTRACTOR=tar; return 0; }
            pkg_install tar && have tar && { EXTRACTOR=tar; return 0; }
            php_has_phar && { EXTRACTOR=phar; return 0; }
            return 1 ;;
    esac
    if have unzip; then EXTRACTOR=unzip; return 0; fi
    pkg_install unzip && have unzip && { EXTRACTOR=unzip; return 0; }
    if php_has_zip; then EXTRACTOR=php; return 0; fi
    return 1
}

# The native path goes through WP-CLI, which shells out to mysqldump/mysql (or
# the mariadb-named equivalents). When those are absent we drive $wpdb instead,
# which always works because WordPress itself has a live database connection.
resolve_db() {
    if have mysqldump || have mariadb-dump; then DB_DUMP=native; else DB_DUMP=php; fi
    if have mysql     || have mariadb;      then DB_LOAD=native; else DB_LOAD=php; fi
    if [ "$DB_DUMP" = php ] || [ "$DB_LOAD" = php ]; then
        # One cheap attempt to get the real client; harmless if it fails.
        for p in default-mysql-client mariadb-client mysql-client; do
            pkg_install "$p" && break
        done
        have mysqldump || have mariadb-dump && DB_DUMP=native
        have mysql     || have mariadb      && DB_LOAD=native
    fi
}

# --- PHP helpers --------------------------------------------------------------
# Written to temp files rather than piped: stdin is already carrying this very
# script when we run over SSH, so it isn't available to hand to `wp eval-file -`.
php_dump_script() {
cat << 'PHPDUMP'
<?php
// Dump every table to $args[0] as portable SQL. Used when no mysqldump exists.
// With $args[1] = 'prefix', only the tables under the site's own prefix.
global $wpdb;
$out = $args[0];
$fh  = fopen( $out, 'w' );
if ( ! $fh ) { WP_CLI::error( 'Cannot write ' . $out ); }
fwrite( $fh, "SET NAMES utf8mb4;\nSET FOREIGN_KEY_CHECKS=0;\n" );
if ( isset( $args[1] ) && 'prefix' === $args[1] ) {
    $tables = $wpdb->get_col( $wpdb->prepare( 'SHOW TABLES LIKE %s', $wpdb->esc_like( $wpdb->prefix ) . '%' ) );
} else {
    $tables = $wpdb->get_col( 'SHOW TABLES' );
}
foreach ( $tables as $table ) {
    $create = $wpdb->get_row( "SHOW CREATE TABLE `$table`", ARRAY_N );
    fwrite( $fh, "\nDROP TABLE IF EXISTS `$table`;\n" . $create[1] . ";\n" );
    $offset = 0;
    $limit  = 500;
    while ( true ) {
        $rows = $wpdb->get_results( "SELECT * FROM `$table` LIMIT $limit OFFSET $offset", ARRAY_A );
        if ( empty( $rows ) ) { break; }
        foreach ( $rows as $row ) {
            $vals = array();
            foreach ( $row as $v ) {
                if ( is_null( $v ) ) {
                    $vals[] = 'NULL';
                } elseif ( ! mb_check_encoding( $v, 'UTF-8' ) ) {
                    // Binary column: hex literals survive a round trip that
                    // quoting would corrupt.
                    $vals[] = '0x' . bin2hex( $v );
                } else {
                    $vals[] = "'" . esc_sql( $v ) . "'";
                }
            }
            // One statement per line so the importer can split on newlines.
            fwrite( $fh, "INSERT INTO `$table` VALUES (" . implode( ',', $vals ) . ");\n" );
        }
        $offset += $limit;
    }
}
fwrite( $fh, "SET FOREIGN_KEY_CHECKS=1;\n" );
fclose( $fh );
WP_CLI::success( 'Database exported.' );
PHPDUMP
}

php_load_script() {
cat << 'PHPLOAD'
<?php
// Import SQL from $args[0] using $wpdb. Used when no mysql client exists.
// Splits on statement boundaries with a small state machine rather than a
// naive explode(';'): post content very often contains ";\n" inside a string
// literal, and splitting there would corrupt the import.
global $wpdb;
$file = $args[0];
$fh   = fopen( $file, 'r' );
if ( ! $fh ) { WP_CLI::error( 'Cannot read ' . $file ); }

$wpdb->query( 'SET FOREIGN_KEY_CHECKS=0' );
$buffer = '';
$in_str = false;
$quote  = '';
$esc    = false;
$count  = 0;

$run = function ( $sql ) use ( $wpdb, &$count ) {
    $sql = trim( $sql );
    if ( $sql === '' ) { return; }
    $wpdb->query( $sql );
    $count++;
};

while ( ( $chunk = fgets( $fh ) ) !== false ) {
    $len = strlen( $chunk );
    for ( $i = 0; $i < $len; $i++ ) {
        $ch      = $chunk[ $i ];
        $buffer .= $ch;
        if ( $esc ) { $esc = false; continue; }
        if ( $ch === '\\' ) { $esc = true; continue; }
        if ( $in_str ) {
            if ( $ch === $quote ) { $in_str = false; }
            continue;
        }
        if ( $ch === "'" || $ch === '"' ) { $in_str = true; $quote = $ch; continue; }
        if ( $ch === ';' ) {
            $run( substr( $buffer, 0, -1 ) );
            $buffer = '';
        }
    }
}
$run( $buffer );
fclose( $fh );
$wpdb->query( 'SET FOREIGN_KEY_CHECKS=1' );
WP_CLI::success( "Imported {$count} statements." );
PHPLOAD
}

php_archive_script() {
cat << 'PHPZIP'
<?php
// $args: 0=mode(create|extract) 1=archive 2=dir 3..=excludes (create only)
$mode    = $args[0];
$archive = $args[1];
$dir     = rtrim( $args[2], '/' );

if ( 'extract' === $mode ) {
    $zip = new ZipArchive();
    if ( true !== $zip->open( $archive ) ) { WP_CLI::error( 'Cannot open archive.' ); }
    $zip->extractTo( $dir );
    $zip->close();
    WP_CLI::success( 'Extracted.' );
    return;
}

// create-follow descends into symlinked folders, as zip and tar -h do: a
// tenant backup is a folder of symlinks into the real install.
$excludes = array_slice( $args, 3 );
$zip      = new ZipArchive();
if ( true !== $zip->open( $archive, ZipArchive::CREATE | ZipArchive::OVERWRITE ) ) {
    WP_CLI::error( 'Cannot create archive.' );
}
$flags = FilesystemIterator::SKIP_DOTS;
if ( 'create-follow' === $mode ) { $flags |= FilesystemIterator::FOLLOW_SYMLINKS; }
$base = basename( $dir );
$it   = new RecursiveIteratorIterator(
    new RecursiveDirectoryIterator( $dir, $flags ),
    RecursiveIteratorIterator::SELF_FIRST
);
foreach ( $it as $path ) {
    $real = $path->getPathname();
    $rel  = $base . '/' . ltrim( substr( $real, strlen( $dir ) ), '/' );
    foreach ( $excludes as $pattern ) {
        if ( fnmatch( $base . '/' . $pattern, $rel ) || fnmatch( $pattern, $rel ) ) { continue 2; }
    }
    if ( $path->isDir() ) { $zip->addEmptyDir( $rel ); } else { $zip->addFile( $real, $rel ); }
}
$zip->close();
WP_CLI::success( 'Archived.' );
PHPZIP
}

# Run a PHP snippet through WP-CLI against $1 (site dir); remaining args are
# passed to the script as $args.
wp_eval() {
    local site_dir="$1" script="$2"; shift 2
    local tmp_php
    tmp_php=$(mktemp "${TMPDIR:-/tmp}/cove-php-XXXXXX.php") || die "mktemp failed"
    "$script" > "$tmp_php"
    local rc=0
    $WP eval-file "$tmp_php" "$@" --path="$site_dir" --skip-plugins --skip-themes >&2 || rc=$?
    rm -f "$tmp_php"
    return $rc
}

# --- WP Freighter tenants -----------------------------------------------------
# WP Freighter runs many sites out of one WordPress install. A tenant is chosen
# by STACKED_SITE_ID under WP-CLI: its tables are stacked_<id>_*, and its files
# are content/<id>/ (dedicated mode), just content/<id>/uploads (hybrid, where
# plugins and themes are shared), or nothing of its own (shared). Everything
# else in the install belongs to every tenant at once, so a tenant backup or
# restore touches only that tenant's tables and that one folder.

php_facts_script() {
cat << 'PHPFACTS'
<?php
// key=value facts about the site WP-CLI booted. Under STACKED_SITE_ID they
// describe that WP Freighter tenant: its prefix, its folders, its URLs.
global $wpdb;
$root    = defined( 'TABLE_PREFIX' ) ? TABLE_PREFIX : $wpdb->prefix;
$uploads = wp_upload_dir( null, false );
$clean   = function ( $value ) { return str_replace( array( "\t", "\r", "\n" ), ' ', (string) $value ); };
$facts   = array(
    'prefix'      => $wpdb->prefix,
    'root_prefix' => $root,
    'abspath'     => untrailingslashit( ABSPATH ),
    'content_dir' => untrailingslashit( WP_CONTENT_DIR ),
    'content_url' => untrailingslashit( WP_CONTENT_URL ),
    'uploads_dir' => untrailingslashit( $uploads['basedir'] ),
    'uploads_url' => untrailingslashit( $uploads['baseurl'] ),
    // The stored value. Freighter defines WP_HOME for tenants without a
    // domain, so get_option( 'home' ) would answer with the main site's.
    'raw_home'    => $wpdb->get_var( "SELECT option_value FROM {$wpdb->options} WHERE option_name = 'home'" ),
    'tables'      => count( $wpdb->get_col( $wpdb->prepare( 'SHOW TABLES LIKE %s', $wpdb->esc_like( $wpdb->prefix ) . '%' ) ) ),
    'freighter'   => file_exists( ABSPATH . 'wp-content/freighter.php' ) ? 'y' : 'n',
);
foreach ( $facts as $key => $value ) {
    echo $key . '=' . $clean( $value ) . "\n";
}
// The tenant registry lives in the main site's options, whichever site booted.
$wpdb->suppress_errors( true );
$sites = maybe_unserialize( $wpdb->get_var( "SELECT option_value FROM {$root}options WHERE option_name = 'stacked_sites'" ) );
if ( is_array( $sites ) ) {
    foreach ( $sites as $site ) {
        echo 'tenant=' . (int) $site['stacked_site_id'] . "\t" . $clean( isset( $site['domain'] ) ? $site['domain'] : '' ) . "\t" . $clean( isset( $site['name'] ) ? $site['name'] : '' ) . "\n";
    }
}
PHPFACTS
}

php_drop_leftovers_script() {
cat << 'PHPDROP'
<?php
// $args: 0=file listing the tables the import created, 1=the prefix this must
// be running under. Drops this site's other tables, so the tenant ends up
// with exactly what was pushed. Nothing outside the prefix is considered.
global $wpdb;
if ( $wpdb->prefix !== $args[1] ) {
    WP_CLI::error( "Expected prefix {$args[1]}, WordPress booted with {$wpdb->prefix}." );
}
$keep = array_filter( array_map( 'trim', file( $args[0] ) ) );
$own  = $wpdb->get_col( $wpdb->prepare( 'SHOW TABLES LIKE %s', $wpdb->esc_like( $wpdb->prefix ) . '%' ) );
foreach ( array_diff( $own, $keep ) as $table ) {
    $wpdb->query( "DROP TABLE IF EXISTS `$table`" );
    WP_CLI::log( "Dropped $table, which the pushed site does not have." );
}
PHPDROP
}

php_prefix_keys_script() {
cat << 'PHPKEYS'
<?php
// The tables were renamed from prefix $args[0] to this site's. WordPress also
// keys the roles option and per-user meta by prefix, so rename those too.
global $wpdb;
$from = $args[0];
$to   = $wpdb->prefix;
if ( $from === $to ) { return; }
$wpdb->query( $wpdb->prepare( "UPDATE {$wpdb->options} SET option_name = %s WHERE option_name = %s", $to . 'user_roles', $from . 'user_roles' ) );
$wpdb->query( $wpdb->prepare( "UPDATE {$wpdb->usermeta} SET meta_key = CONCAT( %s, SUBSTRING( meta_key, %d ) ) WHERE meta_key LIKE %s", $to, strlen( $from ) + 1, $wpdb->esc_like( $from ) . '%' ) );
WP_CLI::log( "Renamed {$from}user_roles and {$from}* user meta to $to." );
PHPKEYS
}

# Does the install at $1 run WP Freighter? Read from the files, not through
# PHP, so the answer holds when WordPress fails to boot: push uses it to
# refuse a whole-install restore that would take every tenant with it.
is_freighter_host() {
    local cfg="$1/wp-config.php"
    [ -f "$cfg" ] || cfg="$(dirname "$1")/wp-config.php"
    [ -f "$1/wp-content/freighter.php" ] || grep -q 'freighter\.php' "$cfg" 2>/dev/null
}

# Boot the site at $1 once (as the tenant, when --tenant exported
# STACKED_SITE_ID) and keep its facts in FACTS.
FACTS=""
load_facts() {
    local site_dir="$1" tmp_php rc=0
    tmp_php=$(mktemp "${TMPDIR:-/tmp}/cove-php-XXXXXX.php") || die "mktemp failed"
    php_facts_script > "$tmp_php"
    FACTS=$($WP eval-file "$tmp_php" --path="$site_dir" --skip-plugins --skip-themes 2>/dev/null) || rc=$?
    rm -f "$tmp_php"
    return $rc
}
fact() { printf '%s\n' "$FACTS" | sed -n "s/^$1=//p" | head -1; }

# Confirm STACKED_SITE_ID really switched WordPress to tenant $TENANT, and work
# out which folder belongs to it alone (TENANT_FILES = content | uploads |
# none, TENANT_DIR = that folder). Sets TENANT_ERROR and returns 1 when it is
# not safe to treat the install as that tenant.
TENANT_FILES=""
TENANT_DIR=""
TENANT_ERROR=""
tenant_check() {
    local prefix root abspath content uploads
    prefix=$(fact prefix); root=$(fact root_prefix); abspath=$(fact abspath)
    content=$(fact content_dir); uploads=$(fact uploads_dir)
    if [ "$prefix" != "stacked_${TENANT}_" ]; then
        TENANT_ERROR="STACKED_SITE_ID=$TENANT did not switch WordPress to tenant $TENANT's tables (it booted with prefix '${prefix:-unknown}'). Is this a WP Freighter host?"
        return 1
    fi
    if [ "$prefix" = "$root" ]; then
        TENANT_ERROR="Tenant $TENANT's prefix ($prefix) is the main site's own."
        return 1
    fi
    if [ "$(fact tables)" = "0" ]; then
        TENANT_ERROR="Tenant $TENANT has no tables. Create it on the host first (wp freighter add)."
        return 1
    fi
    if [ "$content" != "$abspath/wp-content" ]; then
        TENANT_FILES=content; TENANT_DIR="$content"
    elif [ "${uploads#"$abspath/wp-content/"}" = "$uploads" ]; then
        TENANT_FILES=uploads; TENANT_DIR="$uploads"
    else
        TENANT_FILES=none; TENANT_DIR=""
    fi
    if [ -n "$TENANT_DIR" ]; then
        case "$TENANT_DIR" in
            "$abspath"/?*) ;;
            *) TENANT_ERROR="Tenant $TENANT's folder $TENANT_DIR is outside the install."; return 1 ;;
        esac
        case "$TENANT_DIR" in
            "$abspath/wp-content"|"$abspath/wp-content/"*|"$abspath/content"|"$abspath/wp-admin"|"$abspath/wp-includes")
                TENANT_ERROR="Tenant $TENANT's folder $TENANT_DIR is shared with the rest of the install."
                return 1 ;;
        esac
    fi
}

# Every table a dump drops, creates or writes to, one per line.
dump_tables_touched() {
    grep -oE '^(DROP TABLE( IF EXISTS)?|CREATE TABLE( IF NOT EXISTS)?|INSERT( IGNORE)? INTO|REPLACE INTO|LOCK TABLES|ALTER TABLE|TRUNCATE( TABLE)?|RENAME TABLE|DELETE FROM|UPDATE) `[^`]+`' "$1" \
        | sed -E 's/.*`([^`]+)`$/\1/' | sort -u
}

# Copy dump $1 to $4 with every table renamed from prefix $2 to $3. Only the
# name right after a statement keyword changes, never row data.
rename_dump_prefix() {
    local in="$1" from="$2" to="$3" out="$4"
    sed -E \
        -e "s/^(DROP TABLE IF EXISTS|DROP TABLE|CREATE TABLE IF NOT EXISTS|CREATE TABLE|INSERT IGNORE INTO|INSERT INTO|REPLACE INTO|LOCK TABLES|ALTER TABLE|TRUNCATE TABLE|TRUNCATE) \`${from}/\1 \`${to}/" \
        -e "s/^(\/\*![0-9]+ ALTER TABLE) \`${from}/\1 \`${to}/" \
        -e "s/^([[:space:]]+CONSTRAINT .* REFERENCES) \`${from}/\1 \`${to}/" \
        "$in" > "$out"
}

# One search-replace over this site's own tables only. --all-tables would
# reach every tenant in a shared database.
sr_own_tables() {
    $WP search-replace "$2" "$3" --all-tables-with-prefix --skip-columns=guid \
        --path="$1" --skip-plugins --skip-themes --quiet >&2 \
        || log "  (URL rewrite reported errors)"
}

# An archive made from a tenant carries .cove-source, which says where its
# files were served from (/content/<id>/ in dedicated mode, /content/<id>/
# uploads/ in hybrid). Point those links at wp-content under the restored
# site's stored home ($3), before the address itself changes over.
# Scheme-less, so http, https and protocol-relative links all follow.
# $1 = site dir, $2 = unpacked tree, $4 = table scope for search-replace.
rewrite_source_urls() {
    local site_dir="$1" src="$2" url_from="$3" scope="$4" key there want
    [ -f "$src/.cove-source" ] && [ -n "$url_from" ] || return 0
    for key in uploads_url content_url; do
        there=$(sed -n "s/^$key=//p" "$src/.cove-source" | head -1)
        there="${there#*:}"
        want="${url_from#*:}/wp-content"
        [ "$key" = uploads_url ] && want="$want/uploads"
        if [ -n "$there" ] && [ "$there" != "$want" ]; then
            log "Rewriting $there/ -> $want/"
            $WP search-replace "$there/" "$want/" "$scope" --skip-columns=guid \
                --path="$site_dir" --skip-plugins --skip-themes --quiet >&2 \
                || log "  (URL rewrite reported errors)"
        fi
    done
}

# --- subcommands --------------------------------------------------------------
cmd_probe() {
    local site_dir="$1"
    resolve_wp || { echo "wp_cli=missing"; exit 0; }
    resolve_archiver || true
    resolve_extractor "" || true
    resolve_db
    echo "wp_cli=${WP}"
    echo "archiver=${ARCHIVER:-none}"
    echo "extractor=${EXTRACTOR:-none}"
    echo "db_dump=${DB_DUMP}"
    echo "db_load=${DB_LOAD}"
    echo "zip=$(have zip && echo y || echo n)"
    echo "unzip=$(have unzip && echo y || echo n)"
    echo "tar=$(have tar && echo y || echo n)"
    echo "mysqldump=$( { have mysqldump || have mariadb-dump; } && echo y || echo n)"
    echo "mysql=$( { have mysql || have mariadb; } && echo y || echo n)"
    echo "php=$(have php && echo y || echo n)"
    if [ -n "$site_dir" ] && [ -d "$site_dir" ]; then
        echo "home=$($WP option get home --path="$site_dir" --skip-plugins --skip-themes 2>/dev/null)"
        echo "freighter_host=$(is_freighter_host "$site_dir" && echo y || echo n)"
        # Prefix, folders, URLs and WP Freighter's tenant list (tenant=<id>
        # TAB <domain> TAB <name>), so pull and push can offer the tenants.
        if load_facts "$site_dir"; then
            printf '%s\n' "$FACTS"
            if [ -n "$TENANT" ]; then
                if tenant_check; then
                    echo "tenant_files=$TENANT_FILES"
                    echo "tenant_dir=$TENANT_DIR"
                else
                    echo "tenant_error=$TENANT_ERROR"
                fi
            fi
        elif [ -n "$TENANT" ]; then
            echo "tenant_error=WordPress did not boot as tenant $TENANT. Does it exist on this host?"
        fi
    fi
}

# Lay tenant $TENANT out as a standalone site in $2: symlinks to WordPress
# core in the install at $1, and a wp-content made of the tenant's own content
# folder plus its uploads when those live elsewhere (hybrid mode).
stage_tenant() {
    local site_dir="$1" out="$2" entry name
    local abspath content uploads
    abspath=$(fact abspath); content=$(fact content_dir); uploads=$(fact uploads_dir)
    mkdir -p "$out/wp-content" || return 1
    # Core only, by name: the host's root can hold files of its own, and a
    # wp-config.php (or any copy of one) carries the host's credentials.
    for name in wp-admin wp-includes index.php license.txt readme.html xmlrpc.php \
        wp-activate.php wp-blog-header.php wp-comments-post.php wp-config-sample.php \
        wp-cron.php wp-links-opml.php wp-load.php wp-login.php wp-mail.php \
        wp-settings.php wp-signup.php wp-trackback.php; do
        if [ -e "$site_dir/$name" ]; then ln -s "$site_dir/$name" "$out/$name" || return 1; fi
    done
    [ -e "$out/wp-settings.php" ] || return 1
    if [ -d "$content" ]; then
        while IFS= read -r entry; do
            name=$(basename "$entry")
            # The host's bootstrap, when the tenant shares the main wp-content.
            if [ "$name" = freighter.php ] && [ "$content" = "$abspath/wp-content" ]; then continue; fi
            if [ "$name" = uploads ] && [ "$uploads" != "$content/uploads" ]; then continue; fi
            ln -s "$entry" "$out/wp-content/$name" || return 1
        done < <(find "$content" -mindepth 1 -maxdepth 1)
    fi
    if [ "$uploads" != "$content/uploads" ] && [ -d "$uploads" ]; then
        ln -s "$uploads" "$out/wp-content/uploads" || return 1
    fi
}

cmd_backup() {
    local site_dir="$1"; shift
    local -a excludes=()
    local a
    for a in "$@"; do
        case "$a" in --exclude=*) excludes+=("${a#--exclude=}") ;; esac
    done

    [ -d "$site_dir" ] || die "Site directory not found: $site_dir"
    resolve_wp       || die "WP-CLI not found and no PHP to run a phar with."
    resolve_archiver || die "No way to create an archive (need zip, tar, or PHP zip/phar support)."
    resolve_db

    site_dir=$(cd "$site_dir" && pwd -P)
    local parent base
    parent=$(dirname "$site_dir")
    base=$(basename "$site_dir")

    # Named like the old _do output so operators recognise the artefact.
    local stamp rand ext archive
    stamp=$(date +%Y-%m-%d)
    rand=$( (head -c 4 /dev/urandom | od -An -tx1 | tr -d ' \n') 2>/dev/null || echo "$$$(date +%s)" )
    rand=$(echo "$rand" | cut -c1-7)
    case "$ARCHIVER" in tar) ext="tar.gz" ;; *) ext="zip" ;; esac
    archive="$parent/${stamp}_${rand}.${ext}"

    # A tenant is archived from a staging folder beside the install, never in
    # the web root: symlinks to core and to the tenant's own files, laid out
    # like a standalone site so the archive restores like any other. The
    # host's wp-config.php, the other tenants and the main site stay out.
    local stage="" tree="$site_dir"
    if [ -n "$TENANT" ]; then
        load_facts "$site_dir" || die "WordPress did not boot as tenant $TENANT. Does it exist on this host?"
        tenant_check || die "$TENANT_ERROR"
        stage=$(mktemp -d "$parent/.cove-tenant-XXXXXX") || die "mktemp failed"
        tree="$stage/$base"
    fi

    # The dump lands inside the tree so it travels in the archive, exactly
    # where restore expects to find it. For a whole site that is the web root,
    # for as long as the archive takes to build — on a live host when `cove
    # pull` runs this. So: a name nobody can guess (it used to be a fixed
    # db_export.sql), readable by this user only, and removed however this exits.
    log "Exporting database..."
    local dump_rand
    dump_rand=$( (head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n') 2>/dev/null )
    [ -n "$dump_rand" ] || dump_rand="$$$(date +%s)"
    local dump="$tree/db_export-$dump_rand.sql"
    local cleanup="rm -f '$dump'"
    # rm -rf on the staging folder removes its symlinks, never what they point at.
    [ -n "$stage" ] && cleanup="$cleanup; rm -rf '$stage'"
    # shellcheck disable=SC2064
    trap "$cleanup" EXIT
    # PIPE too: run over `ssh … bash -s` there is no terminal, so a dropped
    # connection or a Ctrl-C at the other end arrives as SIGPIPE on the next
    # write to the closed stderr, not as HUP.
    # shellcheck disable=SC2064
    trap "$cleanup; exit 1" HUP INT TERM PIPE

    if [ -n "$stage" ]; then
        stage_tenant "$site_dir" "$tree" || die "Could not stage tenant $TENANT's files."
        # Read by restore: the prefix the tables carry and where the tenant's
        # files were served from, so its URLs can move to wp-content.
        {
            echo "tenant=$TENANT"
            echo "table_prefix=$(fact prefix)"
            echo "content_url=$(fact content_url)"
            echo "uploads_url=$(fact uploads_url)"
        } > "$tree/.cove-source"
        log "Tenant $TENANT: tables $(fact prefix)*, files from ${TENANT_DIR:-the shared wp-content}."
    fi

    # A tenant, or a push to one, takes only the tables under its own prefix:
    # the database is shared with every other site on the host.
    local tables=""
    if [ -n "$TENANT" ] || $ONLY_PREFIX; then
        tables=$($WP db tables --all-tables-with-prefix --format=csv --path="$site_dir" --skip-plugins --skip-themes 2>/dev/null)
        [ -n "$tables" ] || die "No tables found under this site's prefix."
    fi
    if [ "$DB_DUMP" = native ]; then
        ( umask 077; $WP db export "$dump" --path="$site_dir" --add-drop-table \
            --default-character-set=utf8mb4 ${tables:+"--tables=$tables"} --skip-plugins --skip-themes >&2 ) \
            || die "Database export failed."
    else
        log "  (no mysqldump — exporting through WordPress)"
        ( umask 077; wp_eval "$site_dir" php_dump_script "$dump" ${tables:+prefix} ) || die "Database export failed."
    fi

    log "Creating archive (${ARCHIVER})..."
    # Owner-only, like the dump inside it: for a WordPress in a subfolder,
    # $parent is itself the web root. Archivers follow the staging folder's
    # symlinks: zip does by default, tar with -h, PHP with create-follow.
    ( umask 077; cd "$(dirname "$tree")" || exit 1
      case "$ARCHIVER" in
        zip)
            local -a zargs=(-rq "$archive" "$base")
            for a in ${excludes[@]+"${excludes[@]}"}; do zargs+=(-x "$base/$a" "$base/$a/*"); done
            zip "${zargs[@]}" ;;
        tar)
            local -a targs=()
            [ -n "$stage" ] && targs+=(-h)
            for a in ${excludes[@]+"${excludes[@]}"}; do targs+=(--exclude="$base/$a"); done
            tar -czf "$archive" ${targs[@]+"${targs[@]}"} "$base" ;;
        php|phar)
            local mode=create
            [ -n "$stage" ] && mode=create-follow
            local -a pargs=("$mode" "$archive" "$tree")
            for a in ${excludes[@]+"${excludes[@]}"}; do pargs+=("$a"); done
            wp_eval "$site_dir" php_archive_script "${pargs[@]}" ;;
      esac ) || die "Archive creation failed."

    rm -f "$dump"
    [ -f "$archive" ] || die "Archive was not created."
    echo "$archive"
}

# Restore the unpacked site in $2 (dump $3) into tenant $TENANT of the install
# at $1: the tenant's tables, and the one folder that is its own. Core, the
# main site and the other tenants are shared and stay as they are. Everything
# that can refuse does so before anything is changed. $4 = scratch folder,
# $5 = --url-to, then the --keep paths.
restore_tenant() {
    local site_dir="$1" src="$2" sql="$3" held="$4" url_to="$5"; shift 5
    local dest_prefix content_url uploads_url
    dest_prefix=$(fact prefix)
    # Where the tenant serves its files from, read before the import replaces
    # the options some of these are built from.
    content_url=$(fact content_url)
    uploads_url=$(fact uploads_url)

    # The dump: tables renamed to the tenant's prefix, and refused outright if
    # it would touch anything outside it. The database is every tenant's.
    local src_prefix
    src_prefix=$(sed -n 's/^table_prefix=//p' "$src/.cove-source" 2>/dev/null | head -1)
    [ -n "$src_prefix" ] || src_prefix=$(read_table_prefix "$src/wp-config.php")
    [ -n "$src_prefix" ] || src_prefix=$(infer_table_prefix_from_dump "$sql")
    case "$src_prefix" in
        ""|*[!A-Za-z0-9_]*) die "Could not tell which table prefix the archive's site uses. Nothing was changed." ;;
    esac
    if [ "$src_prefix" != "$dest_prefix" ]; then
        log "Renaming tables from ${src_prefix}* to ${dest_prefix}*..."
        rename_dump_prefix "$sql" "$src_prefix" "$dest_prefix" "$held/tenant.sql" \
            || die "Could not rewrite the dump's table names. Nothing was changed."
        sql="$held/tenant.sql"
    fi
    if grep -qiE '^(USE|CREATE DATABASE|DROP DATABASE|CREATE SCHEMA|DROP SCHEMA)[[:space:]]' "$sql"; then
        die "The dump switches or creates databases. Nothing was changed."
    fi
    local foreign
    foreign=$(dump_tables_touched "$sql" | grep -v "^${dest_prefix}" | head -5 | tr '\n' ' ')
    if [ -n "$foreign" ]; then
        die "The dump touches tables outside tenant $TENANT: ${foreign% }. Nothing was changed."
    fi
    grep -oE '^CREATE TABLE( IF NOT EXISTS)? `[^`]+`' "$sql" | sed -E 's/.*`([^`]+)`$/\1/' > "$held/tables.txt"
    grep -qx "${dest_prefix}options" "$held/tables.txt" \
        || die "The dump has no ${dest_prefix}options table once renamed. Nothing was changed."

    # Files: the tenant's own folder is built beside the live one and swapped
    # in, so the site serves its old files right up until the swap.
    local from=""
    case "$TENANT_FILES" in
        content) from="$src/wp-content" ;;
        uploads)
            from="$src/wp-content/uploads"
            log "Plugins and themes are shared by every tenant on this host (hybrid files mode), so only uploads are replaced." ;;
        none)
            log "Plugins, themes and uploads are shared by every tenant on this host (shared files mode), so only the database is replaced." ;;
    esac
    if [ -n "$from" ]; then
        [ -d "$from" ] || die "The archive has no ${from#"$src"/} folder. Nothing was changed."
        local target="$TENANT_DIR" parent incoming old rel k inner
        parent=$(dirname "$target")
        incoming="$parent/.$(basename "$target").cove-incoming-$$"
        old="$parent/.$(basename "$target").cove-old-$$"
        log "Replacing ${target}..."
        mkdir -p "$parent" && mkdir "$incoming" || die "Could not create $incoming."
        cp -R "$from"/. "$incoming"/ || { rm -rf "$incoming"; die "Copying files failed. Nothing was changed."; }
        # --keep paths are site-relative (wp-content/…). The tenant's own copy
        # of each survives, as in a whole-site restore.
        rel="${from#"$src"/}"
        for k in "$@"; do
            case "$k" in "$rel"/*) ;; *) continue ;; esac
            inner="${k#"$rel"/}"
            if [ -e "$target/$inner" ]; then
                rm -rf "$incoming/$inner"
                mkdir -p "$incoming/$(dirname "$inner")"
                cp -Rp "$target/$inner" "$incoming/$inner"
            fi
        done
        if [ -e "$target" ]; then
            mv "$target" "$old" || { rm -rf "$incoming"; die "Could not move $target aside. Nothing was changed."; }
        fi
        if ! mv "$incoming" "$target"; then
            [ -e "$old" ] && mv "$old" "$target"
            rm -rf "$incoming"
            die "Could not move the new files into $target. Nothing was changed."
        fi
        rm -rf "$old"
    fi

    # Database: import, then drop the tenant's tables the archive doesn't
    # have. Never `wp db reset` here: that empties the whole shared database.
    log "Importing database..."
    if [ "$DB_LOAD" = native ]; then
        $WP db import "$sql" --path="$site_dir" --skip-plugins --skip-themes >&2 \
            || die "Database import failed."
    else
        log "  (no mysql client — importing through WordPress)"
        wp_eval "$site_dir" php_load_script "$sql" || die "Database import failed."
    fi
    wp_eval "$site_dir" php_drop_leftovers_script "$held/tables.txt" "$dest_prefix" \
        || die "Could not remove the tenant's old tables."
    if [ "$src_prefix" != "$dest_prefix" ]; then
        wp_eval "$site_dir" php_prefix_keys_script "$src_prefix" \
            || die "Could not rename the prefix-keyed role option and user meta."
    fi

    # URLs, in this tenant's tables only: wp-content links move to the
    # tenant's own folder first, then the address changes over. Scheme-less,
    # so http, https and protocol-relative links all follow.
    if [ -n "$url_to" ]; then
        load_facts "$site_dir" || die "WordPress did not boot as tenant $TENANT after the import."
        local url_from from_content
        url_from=$(fact raw_home)
        if [ -n "$url_from" ]; then
            rewrite_source_urls "$site_dir" "$src" "$url_from" --all-tables-with-prefix
            from_content="${url_from#*:}/wp-content"
            case "$TENANT_FILES" in
                content)
                    if [ "$from_content" != "${content_url#*:}" ]; then
                        log "Rewriting $from_content/ -> ${content_url#*:}/"
                        sr_own_tables "$site_dir" "$from_content/" "${content_url#*:}/"
                    fi ;;
                uploads)
                    if [ "$from_content/uploads" != "${uploads_url#*:}" ]; then
                        log "Rewriting $from_content/uploads/ -> ${uploads_url#*:}/"
                        sr_own_tables "$site_dir" "$from_content/uploads/" "${uploads_url#*:}/"
                    fi ;;
            esac
            if [ "$url_from" != "$url_to" ]; then
                log "Rewriting URLs: $url_from -> $url_to"
                sr_own_tables "$site_dir" "$url_from" "$url_to"
            fi
            $WP option update home "$url_to" --path="$site_dir" --skip-plugins --skip-themes >&2 2>/dev/null
            $WP option update siteurl "$url_to" --path="$site_dir" --skip-plugins --skip-themes >&2 2>/dev/null
        fi
    fi

    $WP cache flush --path="$site_dir" --skip-plugins --skip-themes >&2 2>/dev/null
    log "Restore complete (tenant $TENANT)."
}

cmd_restore() {
    local site_dir="$1" archive="$2"; shift 2
    local url_to=""
    local -a keeps=()
    local a
    for a in "$@"; do
        case "$a" in
            --url-to=*) url_to="${a#--url-to=}" ;;
            --keep=*)
                a="${a#--keep=}"
                case "/$a/" in
                    *"/../"*|//*) die "--keep takes a path inside the site: $a" ;;
                esac
                keeps+=("$a") ;;
        esac
    done

    [ -d "$site_dir" ] || die "Site directory not found: $site_dir"
    [ -f "$archive" ]  || die "Archive not found: $archive"
    resolve_wp || die "WP-CLI not found and no PHP to run a phar with."
    resolve_extractor "$archive" || die "No way to extract the archive (need unzip, tar, or PHP zip support)."
    resolve_db

    site_dir=$(cd "$site_dir" && pwd -P)
    archive=$(cd "$(dirname "$archive")" && pwd -P)/$(basename "$archive")

    # Defence in depth around the one destructive step in this engine (the
    # rm -rf below). `cove pull` always targets a Cove-managed site directory,
    # and `cove push` probes the remote first and refuses anything that isn't a
    # live WordPress install — so a stray --path cannot reach the wipe today.
    # But this helper is a standalone script piped over SSH, so any future
    # caller that skips that probe would otherwise hand rm -rf whatever it was
    # given. Refuse the obviously catastrophic targets outright, and require
    # the destination to actually look like WordPress.
    case "$site_dir" in
        /|/usr|/etc|/var|/var/www|/home|/root|/Users|/opt|/srv|/tmp|"$HOME")
            die "Refusing to restore over $site_dir." ;;
    esac
    if [ ! -f "$site_dir/wp-config.php" ] && [ ! -f "$site_dir/wp-load.php" ] && [ ! -d "$site_dir/wp-includes" ]; then
        die "Refusing to restore over $site_dir: it does not look like a WordPress install."
    fi
    # Push asks for this: replacing a WP Freighter install replaces every
    # tenant on it. Checked from the files, so a host whose tenant list could
    # not be read is still refused. (Pull does not ask: a whole host pulled
    # into Cove is restored over Cove's own copy of it.)
    if [ -z "$TENANT" ] && $REFUSE_FREIGHTER && is_freighter_host "$site_dir"; then
        die "Refusing to restore over $site_dir: it runs WP Freighter, and the whole install holds every tenant's files and tables. Restore one tenant with --tenant=<id>. Nothing was changed."
    fi
    # A tenant is checked before anything is unpacked.
    if [ -n "$TENANT" ]; then
        load_facts "$site_dir" || die "WordPress did not boot as tenant $TENANT. Does it exist on this host?"
        tenant_check || die "$TENANT_ERROR"
    fi

    local work held
    work=$(mktemp -d "${TMPDIR:-/tmp}/cove-restore-XXXXXX") || die "mktemp failed"
    # What the destination keeps (its wp-config.php, --keep paths) waits in a
    # folder of its own: when the archive has no WordPress markers the whole
    # of $work is copied into the site, and anything parked there would land
    # in the web root — wp-config.php.keep included, served as plain text.
    held=$(mktemp -d "${TMPDIR:-/tmp}/cove-keep-XXXXXX") || { rm -rf "$work"; die "mktemp failed"; }
    # shellcheck disable=SC2064
    trap "rm -rf '$work' '$held'" EXIT

    log "Extracting archive (${EXTRACTOR})..."
    case "$EXTRACTOR" in
        unzip) unzip -qo "$archive" -d "$work" ;;
        tar)   tar -xzf "$archive" -C "$work" ;;
        php|phar) wp_eval "$site_dir" php_archive_script extract "$archive" "$work" ;;
    esac || die "Extraction failed."

    # The WordPress tree may sit at the archive root, one folder down (a
    # site folder), or deeper (a Cove export's public/, Local's app/public/,
    # a host backup's files/ or public_html/). Take the shallowest folder
    # that holds wp-settings.php, else wp-config.php, else the old rule.
    local src=""
    local marker
    for marker in wp-settings.php wp-config.php; do
        src=$(find "$work" -maxdepth 5 -name "$marker" -not -path '*/wp-content/*' 2>/dev/null | awk '{ print length($0) "\t" $0 }' | sort -n | head -1 | cut -f2-)
        [ -n "$src" ] && { src=$(dirname "$src"); break; }
    done
    if [ -z "$src" ]; then
        src="$work"
        local entries
        entries=$(find "$work" -mindepth 1 -maxdepth 1 | wc -l | tr -d ' ')
        if [ "$entries" = "1" ]; then
            local only
            only=$(find "$work" -mindepth 1 -maxdepth 1)
            [ -d "$only" ] && src="$only"
        fi
    fi

    # The dump can be anywhere too (db.sql beside public/, app/sql/local.sql,
    # database/backup.sql). Prefer one outside wp-content — backup plugins
    # leave old dumps in uploads — and the largest of those; .sql.gz is fine.
    local sql
    sql=$(find "$work" -maxdepth 6 -type f \( -name '*.sql' -o -name '*.sql.gz' \) -not -path '*/wp-content/*' -not -path '*/wp-includes/*' -not -path '*/wp-admin/*' 2>/dev/null | while IFS= read -r f; do printf '%s\t%s\n' "$(wc -c < "$f" | tr -d ' ')" "$f"; done | sort -rn | head -1 | cut -f2-)
    [ -n "$sql" ] || sql=$(find "$work" -maxdepth 8 -type f \( -name '*.sql' -o -name '*.sql.gz' \) 2>/dev/null | while IFS= read -r f; do printf '%s\t%s\n' "$(wc -c < "$f" | tr -d ' ')" "$f"; done | sort -rn | head -1 | cut -f2-)
    [ -n "$sql" ] || die "No .sql file found in the archive."
    case "$sql" in
        *.gz)
            log "Unpacking $(basename "$sql")..."
            gunzip -c "$sql" > "$held/import.sql" || die "Could not unpack the SQL dump."
            sql="$held/import.sql"
            ;;
    esac
    if [ -f "$src/wp-config.php" ] && grep -Eq "define\(\s*['\"]MULTISITE['\"]\s*,\s*true" "$src/wp-config.php"; then
        die "The archive is a multisite network, which import does not support yet."
    fi
    if [ -n "$TENANT" ]; then
        restore_tenant "$site_dir" "$src" "$sql" "$held" "$url_to" ${keeps[@]+"${keeps[@]}"}
        return
    fi

    # Preserve the destination's own wp-config.php: its credentials are the
    # ones that work here. Shipping the source's would point the restored site
    # at a database that does not exist on this machine.
    local keep_config=""
    if [ -f "$site_dir/wp-config.php" ]; then
        keep_config="$held/wp-config.php.keep"
        cp "$site_dir/wp-config.php" "$keep_config"
    fi

    # --keep paths (files or folders): the destination's own copy survives
    # the swap, the same way wp-config.php does. `cove push` keeps the
    # remote's mu-plugin of the same name as Cove's local-only helper, which
    # never leaves the machine, and the host's own mu-plugins (Kinsta's).
    local k
    for k in ${keeps[@]+"${keeps[@]}"}; do
        if [ -e "$site_dir/$k" ]; then
            mkdir -p "$held/keep/$(dirname "$k")"
            cp -Rp "$site_dir/$k" "$held/keep/$k"
        fi
    done

    log "Replacing files..."
    # Clear the destination except wp-config.php, then move the new tree in.
    # Dumps at the top of the tree (the db_export-*.sql that backup packs
    # there) are imported from where they sit, never copied into the web
    # root, where a failed step below would have left them downloadable.
    find "$site_dir" -mindepth 1 -maxdepth 1 ! -name 'wp-config.php' -exec rm -rf {} + 2>/dev/null
    ( cd "$src" && find . -mindepth 1 -maxdepth 1 ! -name 'wp-config.php' \
        ! -name '*.sql' ! -name '*.sql.gz' ! -name '.cove-source' \
        -exec cp -R {} "$site_dir/" \; ) || die "Copying files failed."
    for k in ${keeps[@]+"${keeps[@]}"}; do
        if [ -e "$held/keep/$k" ]; then
            rm -rf "${site_dir:?}/$k"
            mkdir -p "$site_dir/$(dirname "$k")"
            cp -Rp "$held/keep/$k" "$site_dir/$k"
        fi
    done
    if [ -n "$keep_config" ]; then
        cp "$keep_config" "$site_dir/wp-config.php"

        # Keeping the config also keeps its $table_prefix — almost always `wp_`
        # from `cove add` — while the dump carries the source's tables under
        # whatever prefix the source used. Left alone, WordPress looks for
        # wp_options in a database full of xyz_options, and the URL rewrite
        # below silently no-ops too, since it can't read `home` either (#7).
        # The source's own config travelled in the archive even though it is
        # never copied into place, so sync the prefix from it — or, failing
        # that, from the dump's table names. A tenant's archive carries no
        # config (the host's is the host's); its .cove-source says instead.
        local src_prefix dest_prefix
        src_prefix=$(sed -n 's/^table_prefix=//p' "$src/.cove-source" 2>/dev/null | head -1)
        [ -n "$src_prefix" ] || src_prefix=$(read_table_prefix "$src/wp-config.php")
        [ -n "$src_prefix" ] || src_prefix=$(infer_table_prefix_from_dump "$sql")
        dest_prefix=$(read_table_prefix "$site_dir/wp-config.php")
        if [ -n "$src_prefix" ] && [ "$src_prefix" != "$dest_prefix" ]; then
            log "Setting \$table_prefix to '$src_prefix' to match the imported tables (was '${dest_prefix:-unset}')..."
            $WP config set table_prefix "$src_prefix" --type=variable --path="$site_dir" \
                --skip-plugins --skip-themes >&2 \
                || die "Could not update \$table_prefix in wp-config.php."
        fi
    fi
    rm -f "$site_dir"/*.sql

    log "Importing database..."
    if [ "$DB_LOAD" = native ]; then
        $WP db reset --yes --path="$site_dir" --skip-plugins --skip-themes >&2 \
            || die "Database reset failed."
        $WP db import "$sql" --path="$site_dir" --skip-plugins --skip-themes >&2 \
            || die "Database import failed."
    else
        log "  (no mysql client — importing through WordPress)"
        # The dump's DROP TABLE statements make a separate reset unnecessary,
        # which matters here because `wp db reset` also needs the native client.
        wp_eval "$site_dir" php_load_script "$sql" || die "Database import failed."
    fi

    if [ -n "$url_to" ]; then
        local url_from
        url_from=$($WP option get home --path="$site_dir" --skip-plugins --skip-themes 2>/dev/null)
        rewrite_source_urls "$site_dir" "$src" "$url_from" --all-tables
        if [ -n "$url_from" ] && [ "$url_from" != "$url_to" ]; then
            log "Rewriting URLs: $url_from -> $url_to"
            $WP search-replace "$url_from" "$url_to" --all-tables --skip-columns=guid \
                --path="$site_dir" --skip-plugins --skip-themes --quiet >&2 \
                || log "  (URL rewrite reported errors)"
            # search-replace covers serialized data but not a home/siteurl that
            # differed in scheme only; set them outright to be certain.
            $WP option update home "$url_to" --path="$site_dir" --skip-plugins --skip-themes >&2 2>/dev/null
            $WP option update siteurl "$url_to" --path="$site_dir" --skip-plugins --skip-themes >&2 2>/dev/null
        fi
    fi

    $WP cache flush --path="$site_dir" --skip-plugins --skip-themes >&2 2>/dev/null
    log "Restore complete."
}

# --- entry --------------------------------------------------------------------
QUIET=false
SUB="${1:-}"; shift 2>/dev/null || true
ARGS=()
for a in "$@"; do
    case "$a" in
        --quiet)    QUIET=true ;;
        --wp-cli=*) WP_CLI_PHAR="${a#--wp-cli=}" ;;
        --tenant=*) TENANT="${a#--tenant=}" ;;
        --only-prefix) ONLY_PREFIX=true ;;
        --refuse-freighter) REFUSE_FREIGHTER=true ;;
        *)          ARGS+=("$a") ;;
    esac
done
set -- ${ARGS+"${ARGS[@]}"}
# WP Freighter's bootstrap reads the tenant from the environment under WP-CLI,
# so every wp call below runs as that tenant.
if [ -n "$TENANT" ]; then
    case "$TENANT" in *[!0-9]*) die "--tenant takes a WP Freighter tenant id (a number): $TENANT" ;; esac
    export STACKED_SITE_ID="$TENANT"
fi

case "$SUB" in
    probe)   cmd_probe   "${1:-}" ;;
    backup)  [ $# -ge 1 ] || die "usage: backup <site_dir> [--exclude=GLOB]..."; cmd_backup  "$@" ;;
    restore) [ $# -ge 2 ] || die "usage: restore <site_dir> <archive> [--url-to=URL] [--keep=PATH]..."; cmd_restore "$@" ;;
    *)       die "unknown subcommand: ${SUB:-<none>}" ;;
esac
COVE_TRANSFER_HELPER
}

# --- Cove-side plumbing -------------------------------------------------------

# Run the helper on this machine.
transfer_local() {
    transfer_helper_source | bash -s -- "$@"
}

# Run the helper on the remote, piping it in over the SSH connection pull/push
# already hold open. Nothing is written to the remote filesystem, so there is
# no installer to clean up and no trace left if the run dies partway.
# $1 = ssh option string (unquoted on purpose), $2 = connection, rest = args.
transfer_remote() {
    local opts="$1" conn="$2"; shift 2
    # shellcheck disable=SC2086
    transfer_helper_source | ssh $opts $conn "bash -s -- $(transfer_quote_args "$@")"
}

# Quote helper arguments for the single remote shell string.
transfer_quote_args() {
    local out="" a
    for a in "$@"; do
        out="$out $(shell_quote "$a")"
    done
    echo "$out"
}

# Cache wp-cli.phar locally so it can be sideloaded to a remote that has no
# WP-CLI at all (tier 4). The phar is architecture-independent, which is why
# it is the one binary worth pushing rather than trying to package-install.
transfer_wp_cli_phar() {
    local cache_dir="$COVE_DIR/cache"
    local phar="$cache_dir/wp-cli.phar"
    mkdir -p "$cache_dir"
    if [ ! -s "$phar" ]; then
        curl -fsSL "$COVE_WP_CLI_PHAR_URL" -o "$phar" || { rm -f "$phar"; return 1; }
        [ -s "$phar" ] || { rm -f "$phar"; return 1; }
    fi
    echo "$phar"
}

# Ensure the remote can run WP-CLI, sideloading the phar when it can't.
# Echoes a "--wp-cli=<path>" flag to append (empty when the remote is fine).
# $1 = ssh opts, $2 = connection, $3 = remote site dir.
transfer_ensure_remote_wp_cli() {
    local opts="$1" conn="$2" site_dir="$3"
    local probe
    probe=$(transfer_remote "$opts" "$conn" probe "$site_dir" 2>/dev/null)
    if ! echo "$probe" | grep -q '^wp_cli=missing'; then
        echo ""
        return 0
    fi
    echo "   - Remote has no WP-CLI; sideloading wp-cli.phar over SSH..." >&2
    local phar
    phar=$(transfer_wp_cli_phar) || { echo "" ; return 0; }
    local remote_phar="/tmp/cove-wp-cli.phar"
    # shellcheck disable=SC2086
    if ! ssh $opts $conn "cat > $remote_phar" < "$phar"; then
        echo ""
        return 0
    fi
    echo "--wp-cli=$remote_phar"
}

# --- WP Freighter tenants (Cove side) -------------------------------------------

# Tenant rows from a probe: "<id> TAB <domain> TAB <name>", one per line.
transfer_probe_tenants() {
    printf '%s\n' "$1" | sed -n 's/^tenant=//p'
}

# The id of the tenant --tenant names: an id, a domain (a URL works too) or a
# tenant's name, matched against probe rows. Empty when nothing matches.
transfer_match_tenant() {
    printf '%s\n' "$1" | awk -F'\t' -v w="$2" '
        BEGIN { w = tolower(w); sub(/^[a-z]+:\/\//, "", w); sub(/\/.*$/, "", w); sub(/^www\./, "", w) }
        { d = tolower($2); sub(/^www\./, "", d) }
        $1 == w || (d != "" && d == w) || ($3 != "" && tolower($3) == w) { print $1; exit }'
}

# "15 (cove.run), 16 (beckon.run), …" for error messages.
transfer_list_tenants() {
    printf '%s\n' "$1" | awk -F'\t' 'NF { printf "%s%s (%s)", sep, $1, ($2 != "" ? $2 : $3); sep = ", " }'
}

# Pick a tenant with gum. $2 labels an extra first choice for the main site;
# leave it empty to offer tenants only. Echoes an id, "main", or nothing.
transfer_choose_tenant() {
    local rows="$1" main_label="$2" choice id domain name
    local -a options=()
    [ -n "$main_label" ] && options+=("$main_label")
    while IFS=$'\t' read -r id domain name; do
        [ -n "$id" ] && options+=("Tenant $id · ${domain:-${name:-no domain}}")
    done <<< "$rows"
    choice=$(gum choose --header "This is a WP Freighter host. Which site?" "${options[@]}") || return 0
    case "$choice" in
        "Tenant "*) choice="${choice#Tenant }"; echo "${choice%% *}" ;;
        "") ;;
        *) echo main ;;
    esac
}

# `cove transfer probe [site] [--tenant=<id>]` — surface the capability ladder
# (and the site's prefix, folders and WP Freighter tenants) for debugging a
# host that pull/push struggles with.
cove_transfer() {
    local sub="${1:-}"; shift 2>/dev/null || true
    case "$sub" in
        probe)
            local target="" a
            local -a extra=()
            for a in "$@"; do
                case "$a" in
                    --tenant=*) extra+=("$a") ;;
                    *) target="$a" ;;
                esac
            done
            if [ -n "$target" ] && [[ "$target" != /* ]]; then
                target="$SITES_DIR/${target%.localhost}.localhost/public"
            fi
            echo "🔎 Transfer capabilities (local)"
            transfer_local probe "$target" ${extra[@]+"${extra[@]}"}
            ;;
        *)
            echo "Usage: cove transfer probe [site] [--tenant=<id>]"
            echo ""
            echo "Reports which tools the backup/restore engine will use here."
            ;;
    esac
}
