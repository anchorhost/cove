# A site restored or copied in by hand keeps the address it had where it
# came from: its home and siteurl options still name the live domain (or
# Local's localhost:10003). WordPress builds the login link from them, so the
# link opened that address, and so did every redirect after signing in.
# Rewrite them to this site's own address, as `cove import` and `cove pull`
# do, after saving the database to the site's private/ folder. Only a plain
# single site: a multisite network keeps its domains in tables of its own, a
# Minn Engine site has no WordPress to run search-replace, and WP_HOME or
# WP_SITEURL in wp-config.php win over the database anyway; those get a
# warning instead. An address the site answers on here (a mapping, its twin)
# is left alone. Messages go to stderr with --plain, where stdout is the link.
login_localize_urls() {
    local site_name="$1" site_dir="$2" wp_cmd="$3" plain="$4"
    local public_dir="$site_dir/public" cfg="$site_dir/public/wp-config.php"
    local fd=1 url origin host m entry twin_domain twin_folder twin_as_site key path backup local_url
    local -a wpa=(--skip-plugins --skip-themes) foreign=()
    [ "$plain" = true ] && fd=2
    site_is_minn "$public_dir" && return 0
    local_url=$(url_for "$site_name.localhost")
    for key in home siteurl; do
        url=$( (cd "$public_dir" && $wp_cmd option get "$key" "${wpa[@]}" 2>/dev/null) )
        origin=$(printf '%s' "$url" | sed -nE 's~^([A-Za-z]+://[^/?#]+).*~\1~p')
        host=$(printf '%s' "$origin" | sed -E 's~^[A-Za-z]+://~~; s~:[0-9]+$~~' | tr '[:upper:]' '[:lower:]')
        [ -n "$host" ] || continue
        [ "$host" = "$site_name.localhost" ] && continue
        if [ -f "$site_dir/mappings" ]; then
            grep -Fixq "$host" "$site_dir/mappings" && continue
            while IFS= read -r m || [ -n "$m" ]; do
                case "$m" in \*.*) [[ "$host" == *".${m#\*.}" ]] && continue 2 ;; esac
            done < "$site_dir/mappings"
        fi
        if entry=$(site_twin "$site_dir"); then
            IFS=$'\t' read -r twin_domain twin_folder twin_as_site <<< "$entry"
            [ "$host" = "$twin_domain" ] || [ "$host" = "$twin_as_site" ] && continue
        fi
        [[ " ${foreign[*]} " == *" $origin "* ]] || foreign+=("$origin")
    done
    [ ${#foreign[@]} -gt 0 ] || return 0

    if grep -Eq "^[[:space:]]*define\([[:space:]]*['\"]MULTISITE['\"][[:space:]]*,[[:space:]]*true" "$cfg" \
        || grep -Eq "^[[:space:]]*define\([[:space:]]*['\"]WP_(HOME|SITEURL)['\"]" "$cfg"; then
        echo "⚠️  $site_name's stored URLs name ${foreign[*]}, so this link opens that address. Its wp-config.php sets them (multisite, WP_HOME or WP_SITEURL), so Cove left them alone." >&"$fd"
        return 0
    fi
    backup="$site_dir/private/database-before-url-rewrite-$(date +%Y%m%d-%H%M%S).sql"
    mkdir -p "$site_dir/private"
    echo "🔧 $site_name's stored URLs still name ${foreign[*]}, so the login link would open that address, not this site. Rewriting them to $local_url..." >&"$fd"
    if ! (umask 077; cd "$public_dir" && $wp_cmd db export "$backup" "${wpa[@]}" >/dev/null 2>&1); then
        rm -f "$backup"
        echo "⚠️  Couldn't save the database first, so the URLs were left alone." >&"$fd"
        return 0
    fi
    for origin in "${foreign[@]}"; do
        (cd "$public_dir" && $wp_cmd search-replace "//${origin#*://}" "//${local_url#*://}" --all-tables-with-prefix --skip-columns=guid "${wpa[@]}" --quiet >/dev/null 2>&1)
    done
    # Set outright too: search-replace keeps an http:// scheme, and Cove serves https.
    for key in home siteurl; do
        url=$( (cd "$public_dir" && $wp_cmd option get "$key" "${wpa[@]}" 2>/dev/null) )
        path=$(printf '%s' "$url" | sed -nE 's~^[A-Za-z]+://[^/?#]+(/[^?#]*)?.*$~\1~p')
        (cd "$public_dir" && $wp_cmd option update "$key" "$local_url${path%/}" "${wpa[@]}" >/dev/null 2>&1)
    done
    (cd "$public_dir" && $wp_cmd cache flush "${wpa[@]}" >/dev/null 2>&1)
    echo "   Done. The database from before is in $site_name.localhost/private/$(basename "$backup")." >&"$fd"
}

cove_login() {
    local site_name=""
    local user_identifier="" # Optional: the user to log in as
    local subsite_url=""     # Optional: a subsite of a multisite network
    local plain=false        # --plain: print only the URL, for scripts and agents
    local arg
    for arg in "$@"; do
        case "$arg" in
            --url=*) subsite_url="${arg#*=}" ;;
            --plain|--url-only) plain=true ;;
            -*)
                gum style --foreground red "❌ Error: Unknown option '$arg'."
                echo "Usage: cove login <site> [<user>] [--url=<subsite-url>]"
                exit 1
                ;;
            *)
                if [ -z "$site_name" ]; then site_name="$arg"; elif [ -z "$user_identifier" ]; then user_identifier="$arg"; fi
                ;;
        esac
    done

    # 1. Validate that a site name was provided.
    if [ -z "$site_name" ]; then
        gum style --foreground red "❌ Error: A site name is required."
        echo "Usage: cove login <site> [<user>] [--url=<subsite-url>]"
        exit 1
    fi

    # Reject traversal / metacharacters before the name builds a path we cd into
    # and run wp-cli against — otherwise `cove login ../x` targets a WordPress
    # install outside the Sites tree.
    if ! validate_site_name "$site_name"; then
        gum style --foreground red "❌ Error: Invalid site name '$site_name'."
        exit 1
    fi

    local site_dir="$SITES_DIR/$site_name.localhost"
    local public_dir="$site_dir/public"
    
    # Get WP-CLI command (adds --allow-root if running as root; uses the
    # site's pinned PHP when one is set)
    local wp_cmd
    wp_cmd=$(get_wp_cmd "$site_dir")

    # 2. Check if the site exists and is a WordPress installation.
    if [ ! -d "$site_dir" ] || [ ! -f "$public_dir/wp-config.php" ]; then
        gum style --foreground red "❌ Error: WordPress site '$site_name.localhost' not found."
        exit 1
    fi

    # --url picks a subsite of a multisite network: wp-cli then runs in that
    # site's context, so the minted link lands on ITS wp-login.php and its
    # admin list is consulted. The URL must be one the network actually
    # serves, so a typo cannot quietly mint a link for the main site.
    local url_flag=()
    local label="$site_name.localhost"
    if [ -n "$subsite_url" ]; then
        local wanted="${subsite_url%/}/"
        local known
        known=$( (cd "$public_dir" && $wp_cmd site list --field=url --skip-plugins --skip-themes 2>/dev/null) )
        if [ -z "$known" ]; then
            gum style --foreground red "❌ Error: '$site_name.localhost' is not a multisite network, so --url does not apply."
            exit 1
        fi
        if ! printf '%s\n' "$known" | grep -Fxq "$wanted"; then
            gum style --foreground red "❌ Error: '$subsite_url' is not a site on the '$site_name.localhost' network." "Run 'cove network $site_name' to list its sites."
            exit 1
        fi
        url_flag=(--url="$wanted")
        label="$wanted"
    fi

    [ -z "$subsite_url" ] && login_localize_urls "$site_name" "$site_dir" "$wp_cmd" "$plain"

    local admin_to_login
    if [ -n "$user_identifier" ]; then
        [ "$plain" = true ] || echo "🔎 Verifying user '$user_identifier' for '$label'..."
        local user_roles
        user_roles=$( (cd "$public_dir" && $wp_cmd user get "$user_identifier" --field=roles --format=json "${url_flag[@]}" --skip-plugins --skip-themes 2>/dev/null) )

        if [ -z "$user_roles" ]; then
            gum style --foreground red "❌ Error: User '$user_identifier' not found on this site."
            exit 1
        fi

        # A named user may hold any role: logging in as an editor or a
        # subscriber is how a role's view of the site gets tested. Say so
        # when it is not an administrator (a super admin may hold no role
        # on a subsite at all).
        if ! echo "$user_roles" | grep -q "administrator" && ! (cd "$public_dir" && $wp_cmd super-admin list --skip-plugins --skip-themes 2>/dev/null | grep -Fxq "$user_identifier"); then
            echo "⚠️  '$user_identifier' is not an administrator (roles: $(echo "$user_roles" | tr -d '[]"' ))."
        fi
        
        admin_to_login="$user_identifier"
        [ "$plain" = true ] || echo "✅ User '$admin_to_login' verified."
    else
        [ "$plain" = true ] || echo "🔎 Finding an administrator for '$label'..."
        admin_to_login=$( (cd "$public_dir" && $wp_cmd user list --role=administrator --field=user_login --format=csv "${url_flag[@]}" --skip-plugins --skip-themes | head -n 1) )
        # A subsite with no administrator of its own still has the network's
        # super admins.
        if [ -z "$admin_to_login" ] && [ -n "$subsite_url" ]; then
            admin_to_login=$( (cd "$public_dir" && $wp_cmd super-admin list --skip-plugins --skip-themes 2>/dev/null | head -n 1) )
        fi

        if [ -z "$admin_to_login" ]; then
            gum style --foreground red "❌ Error: Could not find any administrator users for this site."
            exit 1
        fi
        [ "$plain" = true ] || echo "✅ Found admin: '$admin_to_login'."
    fi

    # 3. Refresh the MU-plugin before generating the URL. Always overwrite
    # the file so sites created with older Cove versions pick up changes to
    # the plugin (token format, query-arg name, etc.) without needing a
    # re-add. The file is small and idempotent to regenerate.
    if [ "$plain" = true ]; then inject_mu_plugin "$public_dir" >/dev/null 2>&1; else inject_mu_plugin "$public_dir"; fi

    # 4. Generate the login URL.
    [ "$plain" = true ] || echo "   Generating login link..."
    local login_url
    login_url=$( (cd "$public_dir" && $wp_cmd user login "$admin_to_login" "${url_flag[@]}" --skip-plugins --skip-themes) )

    # 5. Display the final URL or an error message.
    if [ -n "$login_url" ] && [ "$plain" = true ]; then
        echo "$login_url"
    elif [ -n "$login_url" ]; then
        gum style --border normal --margin "1" --padding "1 2" --border-foreground 212 "🔗 One-Time Login URL for '$admin_to_login'" "$login_url"
    else
        gum style --foreground red "❌ Error: Failed to generate the login link after all checks."
        exit 1
    fi
}