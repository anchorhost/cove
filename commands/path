cove_path() {
    local site_name="$1"

    if [ -z "$site_name" ]; then
        gum style --foreground red "❌ Error: A site name is required." >&2
        echo "Usage: cove path <name>" >&2
        exit 1
    fi

    local site_dir="$SITES_DIR/$site_name.localhost/public"

    if [ ! -d "$site_dir" ]; then
        site_not_found "$site_name"
    fi

    echo "$site_dir"
}
